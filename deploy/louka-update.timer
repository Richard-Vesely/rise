# Každou minutu zkusí aktualizovat server Říše (když je nová otestovaná verze, aktualizuje hned, i když se hraje).
# Instalace: deploy/setup-vps.sh; změny tohoto souboru nainstaluje sám deploy/auto-update.sh (nebo ručně: cp deploy/louka-update.* /etc/systemd/system/ && systemctl enable --now louka-update.timer)
# Vypnout: systemctl disable --now louka-update.timer
[Unit]
Description=Říše – automatická aktualizace každou minutu

[Timer]
OnCalendar=minutely
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
